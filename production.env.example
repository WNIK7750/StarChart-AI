# Production contract template. This file contains no usable secret.
# Inject real secrets through the deployment platform; do not copy them here.

AI_NAV_DISABLE_DOTENV=1
AI_NAV_ENV=production
AI_NAV_API_WORKERS=1
AI_NAV_AGENT_RUNTIME_STATE_BACKEND=process_local
AI_NAV_SECRET_KEY=
AI_NAV_DATABASE_PATH=D:/persistent/ai-nav/data/ai_nav.sqlite3
AI_NAV_UPLOAD_DIR=D:/persistent/ai-nav/uploads
RESET_DATABASE_ON_START=0
AI_NAV_CORS_ALLOW_ORIGINS=https://app.example.invalid
AI_NAV_TRUSTED_PROXY_CIDRS=

AI_NAV_REFRESH_COOKIE_SECURE=1
AI_NAV_REFRESH_COOKIE_SAMESITE=lax
AI_NAV_REFRESH_COOKIE_NAME=ai_nav_refresh_token
AI_NAV_REFRESH_COOKIE_PATH=/api/v1/auth
AI_NAV_REFRESH_COOKIE_MAX_AGE_SECONDS=1209600
ACCESS_TOKEN_EXPIRE_MINUTES=10
AI_NAV_HTTPS_CONFIRMED=1
REFRESH_TOKEN_EXPIRE_DAYS=14
AI_NAV_PASSWORD_HASH_ROUNDS=180000
AI_NAV_LOGIN_MAX_FAILED_ATTEMPTS=5
AI_NAV_LOGIN_LOCK_MINUTES=15

AI_NAV_ACCOUNT_DELETION_GRACE_DAYS=7
AI_NAV_ACCOUNT_DELETION_RETENTION_DAYS=30
AI_NAV_PRIVACY_POLICY_VERSION=2026-07-20
AI_NAV_AGENT_MEMORY_POLICY_VERSION=2026-07-01

AVATAR_MAX_UPLOAD_BYTES=2097152
AVATAR_MAX_OUTPUT_BYTES=368640
AVATAR_MAX_DIMENSION=512
AVATAR_MAX_SOURCE_PIXELS=20000000
AVATAR_MAX_REQUEST_BYTES=2162688
AVATAR_MAX_FRAMES=1
AVATAR_PROCESSING_TIMEOUT_SECONDS=2.0

# Keep the Provider deterministic and live traffic disabled until external sign-off.
AI_NAV_AGENT_PROVIDER=deterministic
AI_NAV_AGENT_PROVIDER_LIVE_ENABLED=0
AI_NAV_AGENT_PROVIDER_BASE_URL=
AI_NAV_AGENT_PROVIDER_ALLOWED_HOSTS=
AI_NAV_AGENT_PROVIDER_MODEL=qwen3.5-flash
AI_NAV_AGENT_PROVIDER_UPGRADE_MODEL=qwen3.7-plus
AI_NAV_AGENT_PROVIDER_UPGRADE_RATIO=0
AI_NAV_AGENT_PROVIDER_API_KEY=
AI_NAV_AGENT_PROVIDER_TIMEOUT_SECONDS=8
AI_NAV_AGENT_PROVIDER_MAX_RETRIES=1
AI_NAV_AGENT_PROVIDER_MAX_INPUT_TOKENS=4000
AI_NAV_AGENT_PROVIDER_MAX_OUTPUT_TOKENS=600
AI_NAV_AGENT_PROVIDER_MAX_OUTPUT_CHARS=6000
AI_NAV_AGENT_MAX_EVIDENCE_ITEMS=10
AI_NAV_AGENT_MAX_EVIDENCE_CHARS=12000
AI_NAV_AGENT_STREAM_ENABLED=0
AI_NAV_AGENT_STREAM_BUFFER_EVENTS=8
AI_NAV_AGENT_SESSIONS_ENABLED=0
AI_NAV_AGENT_SESSION_RETENTION_DAYS=30
AI_NAV_AGENT_RESPONSE_REPLAY_TTL_SECONDS=300
AI_NAV_AGENT_RESPONSE_REPLAY_MAX_ENTRIES=512
AI_NAV_AGENT_PER_USER_CONCURRENCY=1
AI_NAV_AGENT_GLOBAL_CONCURRENCY=8
AI_NAV_AGENT_QUEUE_LIMIT=32
AI_NAV_AGENT_QUEUE_TIMEOUT_SECONDS=3
AI_NAV_AGENT_INPUT_CNY_PER_MILLION=0.2
AI_NAV_AGENT_OUTPUT_CNY_PER_MILLION=2
AI_NAV_AGENT_PER_REQUEST_COST_CNY=0.02
AI_NAV_AGENT_PER_USER_DAILY_COST_CNY=0.1
AI_NAV_AGENT_GLOBAL_DAILY_COST_CNY=5
AI_NAV_AGENT_GLOBAL_MONTHLY_COST_CNY=80
