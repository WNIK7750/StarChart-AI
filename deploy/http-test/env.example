# Public deterministic HTTP test instance.
# Copy to /etc/starchart-ai/http-test.env, fill the blank values interactively,
# then set ownership to root:starchart-ai-http-test and mode 0640.
AI_NAV_DISABLE_DOTENV=1
AI_NAV_ENV=http_test
AI_NAV_SECRET_KEY=
AI_NAV_HTTP_TEST_ACCOUNT_USERNAME=
AI_NAV_HTTP_TEST_GUEST_AGENT_ENABLED=1
AI_NAV_PUBLIC_BASE_PATH=/StarChart-AI
AI_NAV_CORS_ALLOW_ORIGINS=
AI_NAV_REFRESH_COOKIE_SECURE=0
AI_NAV_REFRESH_COOKIE_SAMESITE=lax
AI_NAV_REFRESH_COOKIE_PATH=/StarChart-AI/api/v1/auth
AI_NAV_API_WORKERS=1
AI_NAV_AGENT_RUNTIME_STATE_BACKEND=process_local
AI_NAV_AGENT_PROVIDER=deterministic
AI_NAV_AGENT_PROVIDER_LIVE_ENABLED=0
RESET_DATABASE_ON_START=0
