# Production environment contract for https://starchart-ai.xyz.
# Copy to /etc/starchart-ai/production.env and fill blank values interactively.
# Never commit the populated file.
AI_NAV_DISABLE_DOTENV=1
AI_NAV_ENV=production
AI_NAV_PUBLIC_BASE_PATH=
AI_NAV_SECRET_KEY=
AI_NAV_CORS_ALLOW_ORIGINS=https://starchart-ai.xyz
AI_NAV_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
AI_NAV_REFRESH_COOKIE_SECURE=1
AI_NAV_REFRESH_COOKIE_SAMESITE=lax
AI_NAV_REFRESH_COOKIE_NAME=ai_nav_refresh_token
AI_NAV_REFRESH_COOKIE_PATH=/api/v1/auth
AI_NAV_REFRESH_COOKIE_MAX_AGE_SECONDS=1209600
AI_NAV_HTTPS_CONFIRMED=1
AI_NAV_API_WORKERS=1
AI_NAV_AGENT_RUNTIME_STATE_BACKEND=process_local
AI_NAV_AGENT_STREAM_ENABLED=1
AI_NAV_AGENT_SESSIONS_ENABLED=1
AI_NAV_AGENT_SESSION_RETENTION_DAYS=30
# The site does not provide a default model or a shared Provider key. Each
# signed-in user configures an allowed OpenAI-compatible model in Settings.
AI_NAV_AGENT_PROVIDER=deterministic
AI_NAV_AGENT_PROVIDER_LIVE_ENABLED=0
AI_NAV_AGENT_USER_MODEL_ALLOWED_HOSTS=api.openai.com,dashscope.aliyuncs.com,openrouter.ai,api.deepseek.com
RESET_DATABASE_ON_START=0
ACCESS_TOKEN_EXPIRE_MINUTES=10
REFRESH_TOKEN_EXPIRE_DAYS=14
AI_NAV_PASSWORD_HASH_ROUNDS=180000
AI_NAV_LOGIN_MAX_FAILED_ATTEMPTS=5
AI_NAV_LOGIN_LOCK_MINUTES=15
AI_NAV_ACCOUNT_DELETION_GRACE_DAYS=7
AI_NAV_ACCOUNT_DELETION_RETENTION_DAYS=30
AI_NAV_PRIVACY_POLICY_VERSION=2026-08-08
AI_NAV_AGENT_MEMORY_POLICY_VERSION=2026-08-08
# Fail closed until a production Secret Manager adapter is implemented and
# configured. Never place user API keys in this file or in SQLite.
AI_NAV_AGENT_CREDENTIAL_STORE=unconfigured
AVATAR_MAX_UPLOAD_BYTES=2097152
AVATAR_MAX_OUTPUT_BYTES=368640
AVATAR_MAX_DIMENSION=512
AVATAR_MAX_SOURCE_PIXELS=20000000
AVATAR_MAX_REQUEST_BYTES=2162688
AVATAR_MAX_FRAMES=1
AVATAR_PROCESSING_TIMEOUT_SECONDS=2.0
